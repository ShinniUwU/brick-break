{
  "name": "brick-break",
  "version": "1.2.1",
  "description": "Play a Lego break sound when your build fails",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    }
  },
  "bin": {
    "brick-break": "dist/cli.js",
    "bb": "dist/cli.js"
  },
  "files": [
    "dist",
    "sound.mp3"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "build",
    "lego",
    "sound",
    "error",
    "fun",
    "developer-experience",
    "nextjs",
    "react"
  ],
  "author": "ShinniUwU",
  "license": "MIT",
  "homepage": "https://github.com/ShinniUwU/brick-break#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShinniUwU/brick-break.git"
  },
  "bugs": {
    "url": "https://github.com/ShinniUwU/brick-break/issues"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "typescript": "^5.0.0"
  }
}
